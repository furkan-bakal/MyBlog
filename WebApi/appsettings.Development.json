{
  // Sır içeren değerler (ConnectionStrings, TokenOptions:Signature, Clients:Items:0:Secret)
  // bu dosyada TUTULMAZ; user-secrets'tan gelir. Kurulum için:
  //   dotnet user-secrets set "ConnectionStrings:PostgreSqlConnection" "..." -p WebApi
  //   dotnet user-secrets set "TokenOptions:Signature" "..." -p WebApi
  //   dotnet user-secrets set "Clients:Items:0:Secret" "..." -p WebApi
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "TokenOptions": {
    "ExpireByHoure": 10,
    "RefreshTokenExpireByDay": 60,
    "Issuer": "localhost:7276",
    "Audience": "localhost:7276"
  },
  "Clients": {
    "Items": [
      {
        "Name": "Web",
        "Id": "client-web"
      }
    ]
  }
}
