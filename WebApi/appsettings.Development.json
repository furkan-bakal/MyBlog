{
  // Sır içeren değerler (ConnectionStrings, TokenOptions:Signature, Clients:Items:0:Secret,
  // SeedUser:UserName/Password) bu dosyada TUTULMAZ; user-secrets'tan gelir. Kurulum için:
  //   dotnet user-secrets set "ConnectionStrings:PostgreSqlConnection" "..." -p WebApi
  //   dotnet user-secrets set "TokenOptions:Signature" "..." -p WebApi
  //   dotnet user-secrets set "Clients:Items:0:Secret" "..." -p WebApi
  //   dotnet user-secrets set "SeedUser:UserName" "..." -p WebApi
  //   dotnet user-secrets set "SeedUser:Email" "..." -p WebApi
  //   dotnet user-secrets set "SeedUser:Password" "..." -p WebApi
  // Üretimde ortam değişkeni olarak: SeedUser__UserName, SeedUser__Email, SeedUser__Password
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  // Anahtar isimleri CustomTokenOptions'taki özellik adlarıyla birebir aynı olmalı;
  // aksi halde sessizce 0 bağlanır ve token'lar doğdukları anda ölü olur.
  "TokenOptions": {
    "ExpireByHour": 10,
    "RefreshTokenByExpireDay": 60,
    "Issuer": "localhost:7276",
    "Audience": "localhost:7276"
  },
  "Clients": {
    "Items": [
      {
        "Name": "Web",
        "Id": "client-web"
      }
    ]
  }
}
